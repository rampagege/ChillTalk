# ChillTalk Environment Configuration Example
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git

# Alibaba Cloud DashScope API Key
# Get from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_key_here

# Deepgram API Key (alternative ASR provider)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key_here

# OpenRouter API Key (for LLM text polishing)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenRouter Model (e.g., openai/gpt-4o-mini, qwen/qwen-2.5-7b-instruct)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Note: API keys are stored in macOS Keychain via the Settings UI
# This .env.example file is for documentation purposes only
