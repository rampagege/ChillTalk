    "识别、润色和按发音纠正都按简体中文处理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition, polish, and pronunciation correction are all processed as Simplified Chinese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識、整形、発音による修正をすべて簡体字中国語として処理します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식, 다듬기, 발음 수정 모두 간체 중국어 기준으로 처리"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别、润色和按发音纠正都按简体中文处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識、潤飾和依發音修正都以簡體中文處理"
          }
        }
      }
    },
