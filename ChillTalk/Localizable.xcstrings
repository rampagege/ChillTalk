    "%lld 处纠正中，现在能自动纠正 %lld 处（%lld%%）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld of %1$lld corrections are now fixed automatically (%3$lld%%)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 件の修正のうち、%2$lld 件を自動修正できるようになりました（%3$lld%%）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 %1$lld건 중 이제 %2$lld건을 자동 수정할 수 있습니다(%3$lld%%)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld 处纠正中，现在能自动纠正 %2$lld 处（%3$lld%%）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 處修正中，現在能自動修正 %2$lld 處（%3$lld%%）"
          }
        }
      }
    },
