    "说完后整段上传": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads the whole clip when you finish"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話し終えてからまとめてアップロード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말을 마친 후 전체 업로드"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说完后整段上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說完後整段上傳"
          }
        }
      }
    },
    "说完后整段识别：更便宜、通常更准，但要多等 1–3 秒；录音时只显示声音波纹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribes the whole recording after you stop: cheaper and usually more accurate, but takes 1–3 seconds longer; only the waveform shows while recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話し終えてからまとめて認識します。安くて通常はより正確ですが、1〜3 秒ほど余計にかかります。録音中は波形のみ表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말을 마친 후 전체를 인식합니다. 더 저렴하고 보통 더 정확하지만 1~3초 더 걸리며, 녹음 중에는 파형만 표시됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说完后整段识别：更便宜、通常更准，但要多等 1–3 秒；录音时只显示声音波纹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說完後整段辨識：更便宜、通常更準，但要多等 1–3 秒；錄音時只顯示聲音波紋"
          }
        }
      }
    },
    "说话时会夹带英文单词（如产品名、术语），识别时同时考虑英文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mix in English words (e.g. product names, terms); recognition also considers English"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すときに英単語（製品名や用語など）が混じる場合、認識時に英語も考慮します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말할 때 영어 단어(제품명, 용어 등)를 섞어 쓰는 경우 인식 시 영어도 함께 고려합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时会夹带英文单词（如产品名、术语），识别时同时考虑英文"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話時會夾雜英文單字（如產品名稱、術語），辨識時同時考慮英文"
          }
        }
      }
    },
    "请先在设置中配置 %@ API 密钥": {
      "localizations": {
        "en": {
          "stringUnit": {
